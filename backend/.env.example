# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/habittracker?retryWrites=true&w=majority

# Local MongoDB alternative
# MONGODB_URI=mongodb://127.0.0.1:27017/habittracker

JWT_SECRET=change-this-to-a-strong-secret-min-32-chars
JWT_EXPIRES_IN=7d
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
